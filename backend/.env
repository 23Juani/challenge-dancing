# Nombre oficial de la solucion. En blanco por defecto: se define en un solo lugar.
SOLUTION_NAME=

# Host y puerto HTTP/WebSocket principal (REST + /ws/alerts)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Puerto de ingesta en tiempo real para la demo en vivo (TCP crudo)
LIVE_INGEST_TCP_PORT=8081

# Coordenadas base del sistema (La Paz, Bolivia)
BASE_LAT=-16.5204
BASE_LON=-68.1297

# Ruta al dataset filtrado de NASA/NISAR (solo metadatos, no se procesa la senal cruda)
NISAR_FILTERED_H5_PATH=../data/NISAR_L0_PR_RRSD_035_118_A_212S_20261113T102517_20261113T102621_P05036_F_J_001_landslide_filtered.h5

# Adaptador opcional hacia SLIDEGUARD_SOUP (Python). Si no existe el interprete o los modelos,
# el backend usa el motor heuristico interno de forma transparente.
SOUP_PYTHON_BIN=python3
SOUP_PROJECT_DIR=../SLIDEGUARD_SOUP

RUST_LOG=info
